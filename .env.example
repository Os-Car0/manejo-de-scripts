# Configuración local sin secretos. Copiar a .env es opcional.
NODE_ENV=development
PORT=3000
DATA_FILE=./data/tasks.json
# En producción se obtiene de RENDER_GIT_COMMIT. No usar un SHA inventado.
APP_COMMIT=local
# Solo para scripts; definir valores reales cuando se autorice el despliegue.
# DEPLOY_BASE_URL=
# EXPECTED_COMMIT=
# RENDER_DEPLOY_HOOK_URL= (GitHub Actions Secret, nunca versionar)
